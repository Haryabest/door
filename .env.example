# Публичный URL сайта для canonical / Open Graph и генерации robots.txt + sitemap.xml при сборке (без слэша в конце).
VITE_SITE_URL=https://otadoya.ru

# Пустая строка = тот же origin (в dev Vite проксирует /api на бекенд).
# Если фронт и API на разных доменах — укажите базовый URL API, например: https://api.example.com
VITE_API_URL=

# Опционально: Bearer для мутаций без cookie (скрипты). Обычный вход — пароль + сессия на сервере (ADMIN_PASSWORD).
VITE_ADMIN_API_TOKEN=
